[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ArvindSt"]
	path = ArvindSt
	url = https://github.com/shikhartyagi/arvindst
[submodule "GammaFrailty"]
	path = GammaFrailty
	url = https://github.com/cran/GammaFrailty
[submodule "MAARTS"]
	path = MAARTS
	url = https://github.com/cran/MAARTS
[submodule "MleCensoR"]
	path = MleCensoR
	url = https://github.com/cran/MleCensoR
[submodule "UniCensor"]
	path = UniCensor
	url = https://github.com/cran/UniCensor
[submodule "UniCensorEM"]
	path = UniCensorEM
	url = https://github.com/cran/UniCensorEM
